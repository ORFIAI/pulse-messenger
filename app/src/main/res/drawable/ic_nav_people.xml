<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    ic_nav_people — bottom-nav People tab icon
    ===
    Referenced by menu_bottom_nav.xml:
        android:icon="@drawable/ic_nav_people"

    Constraints this file honors:

    1. MONOCHROME TEMPLATE.
       All paths fill with #FFFFFFFF. BottomNavigationView
       applies the selected/unselected tint from the theme
       (colorPrimary when selected, colorOnSurfaceVariant when
       not). Do NOT set a brand color here.

    2. 24dp VIEWPORT.
       Matches ic_nav_chats.xml and ic_nav_profile.xml. All
       three nav icons must be the same viewport and stroke
       weight or the nav bar looks visually inconsistent.

    3. TWO FIGURES, NOT ONE.
       A single person icon is universally read as "Profile" or
       "Account" — the exact metaphor we need for the third nav
       item. Using it here for "People" would create a semantic
       collision: the user would see the same silhouette on two
       tabs and be confused about what distinguishes them.
       The "People" tab is where users find other users, so a
       two-figure composition (a main figure + a secondary
       figure behind) is the correct metaphor, and it also
       mirrors the visual language of Material's
       "group" / "supervisor_account" icons.

    4. OUTLINED STROKE WEIGHT (~2 units).
       Same stroke weight as ic_nav_chats. The "outlined"
       style is what the whole three-icon nav set uses. See
       ic_nav_chats.xml for why we do not mix filled and
       outlined styles in a nav bar.

    5. TWO SEPARATE PATH ELEMENTS, NOT ONE COMPOSITE PATH.
       The two figures are independent shapes with no
       connectivity between them. Putting them in a single
       evenOdd path would be error-prone (the intersecting
       regions where the smaller figure's head/body overlap
       the larger figure's body would create unintended holes
       under evenOdd). Two nonZero paths, drawn in order
       (background figure first, foreground figure second),
       is the correct construction — the foreground figure
       visually occludes the part of the background figure
       behind it.

    6. NO android:autoMirrored.
       The composition is left-right symmetric enough that
       mirroring produces no clear improvement. WhatsApp's
       and Telegram's People/Contacts icons are not auto-mirrored.
       Leave it out.

    Design note (why two figures, not one):
      Some apps use a "single person with a plus badge" for
      "Add contact" — but that metaphor reads as an ACTION
      ("invite someone"), not a DESTINATION. The People tab is
      a destination where you search, view, and start chats
      with existing users. The two-figure composition reads as
      "a group of people" — a state, not an action. This is
      the correct distinction for a bottom-nav item.

    Rendering result at 24dp:
      Two outlined person silhouettes side-by-side — a slightly
      taller one in front-left and a slightly shorter one in
      back-right. Instant recognition as "People" for any user
      familiar with messaging apps.
    ============================================================
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- ============================================================
         BACKGROUND FIGURE (right, slightly smaller)
         ===
         Positioned to the right of the foreground figure and
         drawn first so the foreground figure paints on top of it.
         Only the head and upper shoulders are visible — the
         lower body is occluded by the foreground figure. This
         is the standard "person peeking from behind" construction
         used by Material's group icons.

         Head circle:
           Center (16, 6.5), radius 2.2
         Shoulder arc (partial, occluded by foreground):
           Rounded shape spanning roughly (13, 11) to (21, 15)
           with a rounded top and flat bottom.

         Both contours are outlined (drawn via outer+inner
         contour with evenOdd), matching the foreground figure
         and the overall "outlined nav bar" aesthetic.
         ============================================================ -->

    <!-- Background figure — head -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M14,6.5 Q14,4.3 16,4.3 Q18,4.3 18,6.5 Q18,8.7 16,8.7 Q14,8.7 14,6.5 Z M15,6.5 Q15,5.3 16,5.3 Q17,5.3 17,6.5 Q17,7.7 16,7.7 Q15,7.7 15,6.5 Z" />

    <!-- Background figure — shoulders (partial, right side) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M13,13 Q13,10.5 16,10.5 L17.5,10.5 Q20,10.5 20,13 L20,14.5 L13,14.5 Z M14,13 Q14,11.5 16,11.5 L17.5,11.5 Q19,11.5 19,13 L19,13.5 L14,13.5 Z" />

    <!-- ============================================================
         FOREGROUND FIGURE (left, slightly larger, full outline)
         ===
         Positioned to the left, occupies more vertical space.
         Full silhouette: head circle + shoulder arch.

         Head circle:
           Center (9, 8), radius 3.0
         Body arch:
           Spans (4, 14) to (14, 20) with a rounded top, flat
           bottom (partially cut at the viewport bottom to
           suggest continuation off-canvas).
         ============================================================ -->

    <!-- Foreground figure — head -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M6,8 Q6,5 9,5 Q12,5 12,8 Q12,11 9,11 Q6,11 6,8 Z M7,8 Q7,6 9,6 Q11,6 11,8 Q11,10 9,10 Q7,10 7,8 Z" />

    <!-- Foreground figure — shoulders -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M4,20 Q4,15 9,15 Q14,15 14,20 L14,21 L4,21 Z M5,20 Q5,16 9,16 Q13,16 13,20 L13,20.5 L5,20.5 Z" />

</vector>

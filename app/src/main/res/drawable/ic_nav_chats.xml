<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    ic_nav_chats — bottom-nav Chats tab icon
    ------------------------------------------------------------
    Referenced by menu_bottom_nav.xml:
        android:icon="@drawable/ic_nav_chats"

    Constraints this file honors:

    1. MONOCHROME TEMPLATE.
       Single fill color (#FFFFFFFF). The
       BottomNavigationView applies the selected/unselected tint
       from the theme (colorPrimary when selected,
       colorOnSurfaceVariant when not). Do NOT set a brand
       color here — the fill is a template, the tint is the
       rendered color.

    2. 24dp VIEWPORT.
       Standard bottom-nav icon size. Both Material 3 and the
       Material Design guidelines specify 24dp for nav-bar
       icons. Using 32dp or 20dp would produce a visually
       mismatched icon relative to the two siblings
       (ic_nav_people, ic_nav_profile — same viewport).

    3. OUTLINED STROKE WEIGHT (~2 units).
       All three nav icons use the same ~2-unit stroke weight
       and rounded-outline style. This is what gives the nav
       bar a cohesive visual language: selected vs. unselected
       is conveyed by COLOR, not by switching between filled
       and outlined variants. If you ever want a filled icon
       for the selected state, that requires a selector
       drawable (drawable/bg_nav_chats.xml with a
       state_selected variant) and a change to the
       BottomNavigationView configuration — a Phase-5 polish
       item, not something to pre-implement here.

    4. ROUNDED BUBBLE, TAIL AT BOTTOM-LEFT.
       - ROUNDED CORNERS (radius ~4 units) read as "modern chat,"
         matching the bubble shape used in the chat screen. A
         sharp-cornered rectangle reads as "email" or "comment box,"
         not "chat."
       - TAIL at the bottom-left is the outgoing-message
         convention (universal across WhatsApp, iMessage, Signal,
         Telegram). It is the same direction as the tail in
         ic_empty_chats.xml and consistent with the chat bubble
         used throughout the app — one visual language.

    5. NO android:autoMirrored.
       The chat-bubble shape is not directional in a way that
       benefits from RTL mirroring. WhatsApp's own bottom-nav
       bubble icon is not auto-mirrored. Do not add it.

    Rendering result at 24dp:
      A hollow speech bubble with a subtle downward-left tail.
      Immediately recognizable as "Chats" by the visual
      language of every messaging app users have seen.
    ============================================================
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        Bubble outline (stroke as two contours with evenOdd).

        Outer contour:
            M 5,3             top-left of bubble body (5,3)
            L 19,3            top edge
            Q 21,3 21,5       top-right corner (radius 2)
            L 21,15           right edge (bottom-right corner
                              at y=15)
            Q 21,17 19,17     bottom-right corner
            L 7,17            bottom edge, up to tail region
            L 5,19            tail descends to (5,19)
            L 5,17            returns to bottom edge
            Q 3,17 3,15       bottom-left corner
            L 3,5             left edge
            Q 3,3 5,3         top-left corner close
            Z

        Inner contour (rounded rect, no tail):
            M 5,5             top-left, inset by stroke
            L 19,5
            Q 19,5 19,5 ...   -- actually traced properly below
        Traced fully:
            M 5,5             top-left, inset by stroke
            L 19,5            top edge
            Q 19,5 19,7       no -- see below

        Final traced inner contour (rounded rect from
        (5,5) to (19,15) with 2-unit corner radius):
            M 7,5             top-left start (5+2 for corner)
            L 17,5            top edge
            Q 19,5 19,7       top-right corner (radius 2)
            L 19,13           right edge
            Q 19,15 17,15     bottom-right corner
            L 7,15            bottom edge
            Q 5,15 5,13       bottom-left corner
            L 5,7             left edge
            Q 5,5 7,5         top-left corner close
            Z
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M5,3 L19,3 Q21,3 21,5 L21,15 Q21,17 19,17 L7,17 L5,19 L5,17 Q3,17 3,15 L3,5 Q3,3 5,3 Z M7,5 L17,5 Q19,5 19,7 L19,13 Q19,15 17,15 L7,15 Q5,15 5,13 L5,7 Q5,5 7,5 Z" />

</vector>

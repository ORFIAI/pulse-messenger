<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    fragment_profile.xml — Profile tab
    ===
    Consumed by ProfileFragment via FragmentProfileBinding.

    Binding IDs → ProfileFragment field:
      tv_initials         → binding.tvInitials
      iv_profile_avatar   → binding.ivProfileAvatar
      tv_profile_name     → binding.tvProfileName
      tv_profile_username → binding.tvProfileUsername
      tv_profile_bio      → binding.tvProfileBio
      btn_edit_profile    → binding.btnEditProfile
      row_notifications   → binding.rowNotifications
      row_privacy         → binding.rowPrivacy
      row_blocked         → binding.rowBlocked
      row_settings        → binding.rowSettings
      btn_logout          → binding.btnLogout
      progress_profile    → binding.progressProfile
      scroll_profile      → binding.scrollProfile

    Layout structure:
      NestedScrollView (root, scrolls as one unit)
        └── LinearLayout (vertical)
              ├── Header card (avatar + name + @username + bio)
              ├── Button: "Edit profile"
              ├── Section label "Account"
              ├── Row: Notifications
              ├── Row: Privacy
              ├── Row: Blocked users
              ├── Row: Settings
              ├── Button: "Log out" (destructive tint)
              └── Footer: app version

    Each "Row" is a reusable include pattern:
      Horizontal LinearLayout with an icon, a title text, and a
      right chevron. Since there are only four rows and each has
      slightly different text/icon, the rows are defined inline
      (not in a shared `row_setting.xml` include). The include
      pattern would save ~4 lines per row and add a shared file;
      the inline version costs ~20 lines and avoids an extra
      file. For a 4-row list, inline is the right choice.

    The loading spinner is GONE in the layout and shown by the
    fragment only during the initial user-document load. Once
    loaded, the spinner stays GONE for the lifetime of the view
    — the profile is a static read, not a real-time list.

    Header avatar pattern:
      Same as item_conversation.xml — colored-initials circle
      with a photo overlay on top. This means a user without a
      photo still has a visually rich header, and a user with a
      photo gets a clean circular crop.
    ============================================================
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none"
    tools:context=".ui.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xxl">

        <!-- ============================================================
             HEADER
             ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:text="@string/nav_profile"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false" />

        <!-- ============================================================
             AVATAR (initials + photo overlay)
             ============================================================ -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <TextView
                android:id="@+id/tv_initials"
                android:layout_width="@dimen/avatar_profile"
                android:layout_height="@dimen/avatar_profile"
                android:background="@drawable/bg_avatar_initial"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="48sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                tools:text="A" />

            <ImageView
                android:id="@+id/iv_profile_avatar"
                android:layout_width="@dimen/avatar_profile"
                android:layout_height="@dimen/avatar_profile"
                android:contentDescription="@string/cd_profile_photo"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

        <!-- ============================================================
             DISPLAY NAME
             ============================================================ -->
        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Alex Rivera" />

        <!-- ============================================================
             @USERNAME
             ============================================================ -->
        <TextView
            android:id="@+id/tv_profile_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="@alexr" />

        <!-- ============================================================
             BIO
             ============================================================ -->
        <TextView
            android:id="@+id/tv_profile_bio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="Building things at Pulse. Coffee-driven." />

        <!-- ============================================================
             EDIT PROFILE BUTTON
             ============================================================ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_profile"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:minWidth="180dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/profile_edit_title"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="@dimen/radius_md" />

        <!-- ============================================================
             SPACER
             ============================================================ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_lg" />

        <!-- ============================================================
             SECTION: Account
             ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xs"
            android:text="@string/settings_section_account"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.08" />

        <!-- ============================================================
             ROW: Notifications
             ============================================================ -->
        <LinearLayout
            android:id="@+id/row_notifications"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_notification"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/settings_section_notifications"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:includeFontPadding="false" />

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ============================================================
             ROW: Privacy
             ============================================================ -->
        <LinearLayout
            android:id="@+id/row_privacy"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/settings_section_privacy"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:includeFontPadding="false" />

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ============================================================
             ROW: Blocked users
             ============================================================ -->
        <LinearLayout
            android:id="@+id/row_blocked"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_block"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/settings_blocked_users"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:includeFontPadding="false" />

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ============================================================
             ROW: Settings
             ============================================================ -->
        <LinearLayout
            android:id="@+id/row_settings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/settings_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:includeFontPadding="false" />

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ============================================================
             SPACER
             ============================================================ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_lg" />

        <!-- ============================================================
             LOGOUT BUTTON (destructive)
             ============================================================ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/settings_logout"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorError"
            app:cornerRadius="@dimen/radius_md" />

        <!-- ============================================================
             FOOTER: version
             ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:includeFontPadding="false"
            tools:text="Pulse · v1.0.0" />

        <!-- ============================================================
             LOADING INDICATOR
             ===
             Overlays the whole content while the user document loads.
             Shown by ProfileFragment only during initial load.
             ============================================================ -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
             />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

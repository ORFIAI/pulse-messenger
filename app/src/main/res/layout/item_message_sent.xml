<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bubble_sent_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="48dp"
    android:layout_marginTop="@dimen/space_xxxs"
    android:layout_marginEnd="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_xxxs"
    android:background="@drawable/bg_bubble_sent"
    android:paddingStart="@dimen/space_sm"
    android:paddingEnd="@dimen/space_sm"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_xxs"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintHorizontal_bias="1.0">

    <LinearLayout
        android:id="@+id/ll_reply_preview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/pulseBubbleSentReply"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs"
        android:paddingTop="@dimen/space_xxs"
        android:paddingBottom="@dimen/space_xxs"
        android:layout_marginBottom="@dimen/space_xxs"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <View
            android:layout_width="@dimen/reply_preview_accent_width"
            android:layout_height="match_parent"
            android:background="?attr/pulseBubbleSentText" />
            
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_xxs"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_reply_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/pulseBubbleSentText"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tv_reply_preview_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/pulseBubbleMetaSent"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_media"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:layout_marginBottom="@dimen/space_xxs"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_reply_preview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_media_thumbnail"
            android:layout_width="@dimen/media_bubble_thumbnail"
            android:layout_height="@dimen/media_bubble_thumbnail"
            android:background="?attr/pulseBubbleSentReply"
            android:contentDescription="@string/cd_message_sent_image"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.Pulse.Medium" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/pulseBubbleSentText"
        android:textSize="15sp"
        android:lineSpacingExtra="2dp"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/fl_media"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_deleted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_message_deleted"
        android:textColor="?attr/pulseBubbleMetaSent"
        android:textSize="14sp"
        android:textStyle="italic"
        android:includeFontPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/fl_media"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_edited"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_state_edited"
        android:textColor="?attr/pulseBubbleMetaSent"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:visibility="gone"
        android:layout_marginEnd="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_message_text"
        app:layout_constraintEnd_toStartOf="@id/tv_bubble_time"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_bubble_time" />

    <TextView
        android:id="@+id/tv_bubble_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/pulseBubbleMetaSent"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/tv_message_text"
        app:layout_constraintEnd_toStartOf="@id/iv_status"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/iv_status"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="@dimen/space_xxxs"
        android:layout_marginBottom="1dp"
        app:layout_constraintTop_toTopOf="@id/tv_bubble_time"
        app:layout_constraintBottom_toBottomOf="@id/tv_bubble_time"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

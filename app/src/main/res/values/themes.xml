    <!-- ============================================================
         Settings row style — horizontal LinearLayout used for
         every settings row in activity_settings.xml (theme, privacy
         tiers, blocked users, about) and potentially in future
         settings-like screens.

         Deliberately excludes layout_height and layout_width:
         each consumer declares its own height, because some rows
         are strict 56dp (single-line toggles) while others use
         wrap_content with minHeight="56dp" (rows with a subtitle).
         Adding layout_height here would force a single height on
         every row, which would clip two-line rows.

         The foreground ripple (?attr/selectableItemBackground) is
         the standard Material pattern for clickable rows — it
         produces a ripple across the row's full width, not just
         behind the text. Do NOT change to android:background
         because that would replace the surface background with
         the ripple, producing a transparent-then-rippled row that
         looks broken during the ripple animation.
         ============================================================ -->
    <style name="SettingsRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>


    <!-- ============================================================
         Settings section label style — small uppercase label shown
         above each group of settings rows ("Appearance",
         "Notifications", "Privacy", "Account", "About").

         Uppercase is applied via android:textAllCaps="true" rather
         than by writing the strings in caps. This is deliberate:
         strings.xml keeps sentence-case values so translators get
         natural-language text ("Notificações" in Portuguese, not
         "NOTIFICAÇÕES"), and the style handles the visual casing.
         For languages where textAllCaps produces incorrect casing
         (rare, but exists in some scripts), the style can be
         overridden per-locale via values-XX/themes.xml in a future
         pass — not needed for v1.

         The letterSpacing="0.08" produces the slightly-tracked look
         that is standard for section labels in Material settings
         screens. 0.08 is measured in em units (8% of the font size),
         not sp or dp.
         ============================================================ -->
    <style name="SettingsSectionLabel">
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_lg</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         Theme.Pulse — main app theme (DARK variant)
         ===
         This is NOT a separate theme. It is the SAME resource name
         "Theme.Pulse" provided in the -night configuration qualifier.
         Android's resource resolver picks this version automatically
         when uiMode == UI_MODE_NIGHT_YES (system dark mode OR
         AppCompatDelegate.setDefaultNightMode(MODE_NIGHT_YES)).

         CRITICAL: every color attribute that values/themes.xml
         overrides must be overridden here as well, including the
         nine custom pulse* attributes at the bottom. Missing one
         means that attribute falls back to the Material 3 parent's
         dark defaults (for semantic attrs) or to the light-mode
         value (for our custom pulse* attrs, because theme
         attributes are resolved per-configuration and do NOT
         inherit from the light file at runtime).
         ============================================================ -->
    <style name="Theme.Pulse" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ===
             PRIMARY
             === -->
        <item name="colorPrimary">@color/md_primary_dark</item>
        <item name="colorOnPrimary">@color/md_on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/md_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container_dark</item>
        <item name="colorPrimaryInverse">@color/md_primary_light</item>

        <!-- ===
             SECONDARY
             === -->
        <item name="colorSecondary">@color/md_secondary_dark</item>
        <item name="colorOnSecondary">@color/md_on_secondary_dark</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container_dark</item>

        <!-- ===
             TERTIARY
             === -->
        <item name="colorTertiary">@color/md_tertiary_dark</item>
        <item name="colorOnTertiary">@color/md_on_tertiary_dark</item>

        <!-- ===
             BACKGROUND and SURFACE
             === -->
        <item name="android:colorBackground">@color/md_background_dark</item>
        <item name="colorOnBackground">@color/md_on_background_dark</item>
        <item name="colorSurface">@color/md_surface_dark</item>
        <item name="colorOnSurface">@color/md_on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant_dark</item>

        <item name="colorSurfaceInverse">@color/md_on_surface_dark</item>
        <item name="colorOnSurfaceInverse">@color/md_surface_dark</item>

        <item name="colorSurfaceContainerLow">@color/md_surface_dark</item>

        <!-- ===
             OUTLINE
             === -->
        <item name="colorOutline">@color/md_outline_dark</item>
        <item name="colorOutlineVariant">@color/md_outline_variant_dark</item>

        <!-- ===
             ERROR
             === -->
        <item name="colorError">@color/md_error_dark</item>
        <item name="colorOnError">@color/md_on_error_dark</item>
        <item name="colorErrorContainer">@color/md_error_container_dark</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container_dark</item>

        <!-- ===
             CONTROL STATE COLORS
             Dark ripple is translucent WHITE — a translucent black
             ripple on a dark surface is invisible.
             === -->
        <item name="colorControlHighlight">@color/ripple_dark</item>
        <item name="colorControlNormal">@color/md_on_surface_variant_dark</item>

        <!-- ===
             SYSTEM BARS
             windowLightStatusBar = FALSE → light (white) icons on the
             dark status bar. The single most important flip in this
             file. Same for navigation bar.
             === -->
        <item name="android:statusBarColor">@color/md_surface_dark</item>
        <item name="android:navigationBarColor">@color/md_surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- ===
             WINDOW BACKGROUND
             === -->
        <item name="android:windowBackground">@color/md_background_dark</item>

        <!-- Shape appearances are NOT re-declared — corner radii do
             not change with theme. They come through the parent. -->

        <!-- ========================================================
             CUSTOM PULSE ATTRIBUTES — DARK VALUES
             ===
             These are the DARK counterparts of the nine assignments
             in values/themes.xml. They MUST exist or the bubble
             drawables would resolve to nothing (drawables use
             ?attr/pulseBubbleSent etc., which is a per-configuration
             lookup — there is no fallback to the light file).

             Note: some tokens — bubble_sent_*, for example — are
             deliberately the SAME hex value across light and dark
             (a deep indigo reads well on both backgrounds). They are
             still declared here because the ATTRIBUTE must be
             populated in every configuration, regardless of whether
             the underlying color changes.
             ======================================================== -->
        <item name="pulseBubbleSent">@color/bubble_sent_dark</item>
        <item name="pulseBubbleSentText">@color/bubble_sent_text_dark</item>
        <item name="pulseBubbleReceived">@color/bubble_received_dark</item>
        <item name="pulseBubbleReceivedText">@color/bubble_received_text_dark</item>
        <item name="pulseBubbleSentReply">@color/bubble_sent_reply_bg_dark</item>
        <item name="pulseBubbleReceivedReply">@color/bubble_received_reply_bg_dark</item>
        <item name="pulseBubbleMetaSent">@color/bubble_meta_sent_dark</item>
        <item name="pulseBubbleMetaReceived">@color/bubble_meta_received_dark</item>
        <item name="pulseChatBackground">@color/chat_background_dark</item>

    </style>


    <!-- ============================================================
         Theme.Pulse.Auth — dark variant
         ===
         Only windowBackground needs overriding — every other
         attribute Theme.Pulse.Auth uses comes through its parent
         "Theme.Pulse", which resolves to the DARK version in night
         mode. That inheritance chain is why this block is only two
         lines.
         ============================================================ -->
    <style name="Theme.Pulse.Auth" parent="Theme.Pulse">
        <item name="android:windowBackground">@color/md_background_dark</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

</resources>
